import cv2

def main():
    # Adjusted resolution
    width, height = 1920, 1080

    # GStreamer pipeline for capturing frames
    capture_pipeline = (
        f'v4l2src device=/dev/video2 ! '
        f'video/x-raw,format=YUY2,width={width},height={height} ! '
        'videoconvert ! '
        'appsink'
    )

    # GStreamer pipeline for displaying frames with caps
    display_pipeline = (
        'appsrc ! '
        f'video/x-raw, format=BGR, width={width}, height={height}, framerate=30/1 ! '
        'videoconvert ! '
        'waylandsink'
    )

    # OpenCV VideoCapture for capturing frames
    cap = cv2.VideoCapture(capture_pipeline, cv2.CAP_GSTREAMER)
    if not cap.isOpened():
        print("Error: Unable to open capture pipeline.")
        return

    # OpenCV VideoWriter for displaying frames
    out = cv2.VideoWriter(display_pipeline, cv2.CAP_GSTREAMER, 0, 30, (width, height), True)
    if not out.isOpened():
        print("Error: Unable to open display pipeline.")
        return

    try:
        while True:
            ret, frame = cap.read()
            if not ret:
                print("Error: Failed to read frame from capture pipeline.")
                break

            # Process the frame (convert to grayscale)
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            processed_frame = cv2.cvtColor(gray, cv2.COLOR_GRAY2BGR)

            # Display the processed frame for debugging
            cv2.imshow('Processed Frame', processed_frame)
            if cv2.waitKey(1) & 0xFF == ord('q'):
                break

            # Write the processed frame to the display pipeline
            out.write(processed_frame)

    finally:
        cap.release()
        out.release()
        cv2.destroyAllWindows()

if __name__ == '__main__':
    main()
